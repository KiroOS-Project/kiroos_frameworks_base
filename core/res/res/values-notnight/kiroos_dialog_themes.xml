<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS light theme (Settings > Display > Theme: Light): the system alert dialogs, made dark
     for KiroOS in themes_device_defaults.xml, are light again -->
<resources>
    <style name="Theme.DeviceDefault.Dialog.Alert" parent="Theme.Material.Light.Dialog.Alert">
        <item name="windowTitleStyle">@style/DialogWindowTitle.DeviceDefault</item>

        <!-- Color palette -->
        <item name="colorPrimary">@color/primary_device_default_light</item>
        <item name="colorPrimaryDark">@color/primary_dark_device_default_light</item>
        <item name="colorAccent">@color/accent_device_default_light</item>
    </style>

    <style name="Theme.DeviceDefault.Light.Dialog.Alert" parent="Theme.Material.Light.Dialog.Alert">
        <item name="windowTitleStyle">@style/DialogWindowTitle.DeviceDefault</item>

        <!-- Color palette -->
        <item name="colorPrimary">@color/primary_device_default_light</item>
        <item name="colorPrimaryDark">@color/primary_dark_device_default_light</item>
        <item name="colorAccent">@color/accent_device_default_light</item>
    </style>
</resources>
