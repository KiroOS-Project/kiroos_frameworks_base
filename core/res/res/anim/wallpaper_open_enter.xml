<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS: the home screen settles back in (slight zoom) while the app closes on top.
     The wallpaper stays still behind it. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
        android:detachWallpaper="true" android:shareInterpolator="false" android:zAdjustment="normal">
    <scale android:fromXScale="0.94" android:toXScale="1.0"
            android:fromYScale="0.94" android:toYScale="1.0"
            android:pivotX="50%" android:pivotY="50%"
            android:fillEnabled="true" android:fillBefore="true" android:fillAfter="true"
            android:interpolator="@interpolator/decelerate_quint"
            android:duration="320" />
</set>