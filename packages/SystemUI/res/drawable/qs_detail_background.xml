<!-- KiroOS: the control centre's opaque rounded-bottom surface, in the theme's colour.
     A plain shape on purpose: as a <transition> (stock) Android 7 kept the cached drawable
     across a Dark / Light switch, so after switching to Light every detail sheet (Wi-Fi,
     Bluetooth, mobile data...) stayed black while its text turned dark. QSDetailClipper
     works without a transition. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/kiroos_panel_bg" />
    <corners
        android:bottomLeftRadius="@dimen/kiroos_panel_corner_radius"
        android:bottomRightRadius="@dimen/kiroos_panel_corner_radius" />
</shape>
