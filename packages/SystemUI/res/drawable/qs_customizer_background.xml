<!-- KiroOS: the tile editor on the control centre's own surface colour (black / #F2F2F7).
     It was a stock two-layer transition to ?android:attr/colorPrimary: a colour the theme
     switch never changed, and a drawable Android 7 keeps cached across a Dark / Light switch
     (see qs_detail_background). QSDetailClipper works without a transition. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/kiroos_panel_bg" />
</shape>
