<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS: a network / device in the control centre lists; the connected one is highlighted
     (QSDetailItems sets it activated) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/qs_tile_bg_pressed">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/kiroos_detail_row_active" />
                    <stroke android:width="1dp" android:color="@color/kiroos_detail_row_stroke" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/kiroos_detail_row" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
