<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS control center editor: the red − on a control (removes it). The ring in the panel's
     colour sets it off the tile under it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FFFF453A" />
            <stroke
                android:width="2dp"
                android:color="@color/kiroos_panel_bg" />
        </shape>
    </item>
    <item
        android:width="10dp"
        android:height="2.5dp"
        android:gravity="center">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="1.25dp" />
        </shape>
    </item>
</layer-list>
